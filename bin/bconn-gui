#!/usr/bin/env python3
"""Repository launcher for the BConn tray application."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from bconn.ui import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(show_window="--window" in sys.argv[1:]))
